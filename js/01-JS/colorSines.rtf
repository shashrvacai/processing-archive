let aR  =  0 ;\
let aG  =  0 ;\
let aB =  0 ;\
let speed= 0 ;\
function setup() \{\
	createCanvas(windowWidth, windowHeight);\
	mouseX = width * 0.4;\
		setupAudio();\
\}\
\
function draw() \{\
	background(200,2);\
	var lc = 10;\
	var r  = map(sin(aR),1,-1,10,255);\
	var g  = map(sin(aG),1,-1,10,255);\
	var b  = map(sin(aB),1,-1,0,255);\
	fill(r,g,b);\
	for(var i = 0; i < lc; i++) \{\
		var s = width / lc;\
		var x = map(i, 0, lc - 1, 0, width);\
		var osc = sin((speed * .01) + i * 3);\
		var y = height / 2 + osc * abs(mouseY - height / 2);\
		noStroke();\
		ellipse(x, y, s, s);\
	\}\
	aR += 0.005;\
	aG	+= 0.001 ;\
	aB += 0.02 ;\
	\
	speed += ampEase/10 ;\
	updateAudio();\
\}\
// Audio stuff\
let mic, amp = 0.0,\
	ampStereo = \{\
		l: 0.0,\
		r: 0.0\
	\},\
	ampEase = 0.0;\
\
function setupAudio() \{\
	mic = new p5.AudioIn();\
	mic.start();\
\}\
\
function updateAudio() \{\
	amp = mic.getLevel() * 1000; // mixed channels\
	ampStereo.l = mic.amplitude.getLevel(0) * 500; // left channel\
	ampStereo.r = mic.amplitude.getLevel(1) * 500; // right channel\
	ampEase = ease(amp, ampEase, 0.075); // smooth 'amp'\
\}\
}